# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this should be excluded.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if the platform is not identical, the lock file will fail.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains details of exact versions of dependencies.
#   It is typically recommended to commit it, but can be ignored under some circumstances.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains details of exact versions of dependencies.
# pdm.lock
#   local paths inside '.pdm-python'
.pdm-python
#   local coverage reports
.pdm-build/

# PEP 582; modern local dependency directory
__pypackages__/

